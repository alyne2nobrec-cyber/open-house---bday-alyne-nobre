rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regras dedicadas para a Galeria do Apê (fotos, gifs e vídeos)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ['alyne.custodio@dux-company.com', 'alyne2.nobre.c@gmail.com']
                   && (
                     (request.resource.contentType.matches('video/.*') && request.resource.size <= 30 * 1024 * 1024)
                     || (request.resource.contentType == 'image/gif' && request.resource.size <= 5 * 1024 * 1024)
                     || (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024)
                   );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ['alyne.custodio@dux-company.com', 'alyne2.nobre.c@gmail.com']
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
